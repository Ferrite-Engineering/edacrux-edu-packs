# Per-pack build artifacts (intermediate iverilog output).
# fixtures/ contents are committed; build/ is regenerated by build.sh.
packs/*/build/

# A run a student starts from a Flow pack's simcrux.yaml lands beside it
# (runs/<tag>/). The committed runs are under fixtures/flow/ and are not this.
packs/*/runs/

# macOS finder metadata — noise in a repo professors will clone.
.DS_Store
._*
dist/

# Python bytecode from running the verifier's unit tests.
__pycache__/

# Local credentials, in every spelling the suite's tooling uses. Never
# committed. `.dev.vars` is wrangler's local-secrets file; `.envrc` is
# direnv's. The gitleaks job scans the working tree as well as the history
# (`gitleaks dir` ignores .gitignore), so these lines stop a credential being
# committed without hiding it from the scan.
.dev.vars
.dev.vars.*
.env
.env.*
.envrc
