#!/usr/bin/env python3
"""edacrux-pack-verify — check that an EDU pack is internally consistent.

WHAT IT VERIFIES

Every pack ships a machine-readable contract in `fixtures/expected.json`: named
checkpoints saying "at time T, signal S holds value V". Every pack also ships
`fixtures/reference.vcd`, produced by an open-source simulator from the pack's
own RTL. Those two must agree — and until now nothing checked that they did.

This replays the VCD and evaluates every checkpoint against it. That catches the
failure mode that actually matters for a professor: a handout that says "at
2575 ns the counter reads 0xFF" while the waveform the student opens says
something else. The same holds for source line numbers: a handout, note or
solution that cites `src/x.v` line N is checked against line N of that file. It needs no GUI, no WaveCrux install, and no network, so it runs
on every push.

A SimCrux Flow pack ships flow run directories instead of a waveform. Its
checkpoints state a verdict, step statuses, metrics, a worst path and a mapped
register, and each is recomputed here from the run's own report, log, metrics,
step directories and RTL, never from anything SimCrux shows.

WHAT IT DOES NOT VERIFY

It does not prove a pack works against a specific WaveCrux *release* — that
needs the app driven over WCP, replaying each checkpoint through the tool. That
layer is not built. Until it is, `verified_against` in pack.yaml stays empty and
nothing here should be described as release-verified. The distinction is the
whole reason the marketing copy was corrected: this checks the pack against
itself, which is necessary but not the same claim.

USAGE
    tools/edacrux-pack-verify                 # every pack
    tools/edacrux-pack-verify --pack uart-lab # one pack
    tools/edacrux-pack-verify --output junit  # JUnit XML on stdout
    tools/edacrux-pack-verify --quiet         # only failures

EXIT CODES
    0  all checks passed
    1  one or more checks failed
    2  usage / structural error (a pack could not be read at all)
"""
from __future__ import annotations

import argparse
import json
import pathlib
import re
import sys
import xml.etree.ElementTree as ET

ROOT = pathlib.Path(__file__).resolve().parent.parent
PACKS = ROOT / "packs"

VALID_FORMATS = {
    "binary", "hexadecimal", "octal", "unsignedDecimal", "signedDecimal",
    "ascii", "ieee754Single", "ieee754Double", "fixedPointQ",
    "signedMagnitude", "grayCode", "namedEnum",
}
SESSION_SCHEMA_VERSION = 3

_TIMESCALE = re.compile(r"\$timescale\s+([\d.]+)\s*([munpf]?s)\s*\$end", re.S)
_UNIT_SECONDS = {"s": 1e0, "ms": 1e-3, "us": 1e-6, "ns": 1e-9, "ps": 1e-12, "fs": 1e-15}
# 8'h00 / 1'b0 / 2'd1 / 8'b1010_1010 — width, base, digits
_VERILOG_LIT = re.compile(r"^\s*(\d+)'([bBhHdDoO])([0-9a-fA-FxXzZ_]+)\s*$")


class Vcd:
    """Minimal VCD reader: header map plus value-at-time lookup."""

    def __init__(self, path: pathlib.Path):
        self.path = path
        self.id_to_paths: dict[str, list[str]] = {}
        self.path_to_id: dict[str, str] = {}
        self.tick_ns = 1.0
        # signal id -> list of (tick, value string)
        self._changes: dict[str, list[tuple[int, str]]] = {}
        self._parse()

    def _parse(self) -> None:
        text = self.path.read_text(errors="replace")

        m = _TIMESCALE.search(text)
        if m:
            mag, unit = float(m.group(1)), m.group(2)
            self.tick_ns = mag * _UNIT_SECONDS[unit] / 1e-9

        scope: list[str] = []
        in_header = True
        tick = 0
        for raw in text.splitlines():
            line = raw.strip()
            if not line:
                continue
            if in_header:
                if line.startswith("$scope"):
                    p = line.split()
                    if len(p) >= 3:
                        scope.append(p[2])
                    continue
                if line.startswith("$upscope"):
                    if scope:
                        scope.pop()
                    continue
                if line.startswith("$var"):
                    # $var wire 8 # count [7:0] $end
                    p = line.split()
                    if len(p) >= 5:
                        sid, name = p[3], p[4]
                        # Escaped identifier: VCD writes array words as
                        # `\regs[1]`. The backslash is a delimiter, not part of
                        # the name — keeping it makes every array-word path miss.
                        if name.startswith("\\"):
                            name = name[1:]
                        full = ".".join(scope + [name])
                        self.id_to_paths.setdefault(sid, []).append(full)
                        self.path_to_id[full] = sid
                    continue
                if line.startswith("$enddefinitions"):
                    in_header = False
                    continue
                continue

            if line.startswith("#"):
                try:
                    tick = int(line[1:])
                except ValueError:
                    pass
                continue
            if line[0] in "01xXzZ" and len(line) > 1:
                # scalar: value then id, no space
                self._changes.setdefault(line[1:], []).append((tick, line[0]))
            elif line[0] in "bB":
                parts = line.split()
                if len(parts) >= 2:
                    self._changes.setdefault(parts[1], []).append((tick, parts[0][1:]))
            elif line[0] in "rR":
                parts = line.split()
                if len(parts) >= 2:
                    self._changes.setdefault(parts[1], []).append((tick, parts[0][1:]))

    def value_at(self, path: str, time_ns: float) -> str | None:
        """Value of `path` at `time_ns` — the last change at or before it."""
        sid = self.path_to_id.get(path)
        if sid is None:
            return None
        tick = time_ns / self.tick_ns
        last = None
        for t, v in self._changes.get(sid, []):
            if t <= tick + 1e-9:
                last = v
            else:
                break
        return last


def parse_expected(lit: str) -> tuple[int | None, int | None, bool]:
    """(width, value, is_unknown) from a Verilog literal like 8'hFF.

    is_unknown is True when the literal contains x/z, which must match a VCD
    value that is also unknown rather than comparing numerically.
    """
    m = _VERILOG_LIT.match(lit)
    if not m:
        return None, None, False
    width = int(m.group(1))
    base = m.group(2).lower()
    digits = m.group(3).replace("_", "")
    if re.search(r"[xXzZ]", digits):
        return width, None, True
    radix = {"b": 2, "h": 16, "d": 10, "o": 8}[base]
    try:
        return width, int(digits, radix), False
    except ValueError:
        return width, None, False


def vcd_to_int(v: str) -> tuple[int | None, bool]:
    """(value, is_unknown) for a VCD scalar/vector payload."""
    if re.search(r"[xXzZ]", v):
        return None, True
    try:
        return int(v, 2), False
    except ValueError:
        return None, False


class Netlist:
    """Yosys JSON netlist reader — the structure NetCrux loads.

    Exposes exactly what the NetCrux packs assert about: a module's ports
    (direction + width), the generic cell types inside it, and the submodules
    it instantiates.
    """

    def __init__(self, path: pathlib.Path):
        self.modules = json.loads(path.read_text()).get("modules", {})
        self._module_names = set(self.modules)

    def has_module(self, name: str) -> bool:
        return name in self.modules

    def port(self, module: str, port: str) -> dict | None:
        p = self.modules.get(module, {}).get("ports", {}).get(port)
        if p is None:
            return None
        return {"direction": p.get("direction"), "width": len(p.get("bits", []))}

    def cell_types(self, module: str) -> set[str]:
        cells = self.modules.get(module, {}).get("cells", {})
        return {c.get("type") for c in cells.values()}

    def instance_count(self, module: str, cell_type: str) -> int:
        cells = self.modules.get(module, {}).get("cells", {})
        return sum(1 for c in cells.values() if c.get("type") == cell_type)

    def submodules(self, module: str) -> set[str]:
        # A cell whose type is another module in this netlist is a submodule
        # instance; Yosys internal cells start with '$'.
        return {t for t in self.cell_types(module) if t in self._module_names}


class LintReport:
    """Normalised lint report — the unified view LintCrux presents after
    aggregating an engine. Produced by a pack's build.sh from real engine output
    (e.g. Verilator), so the contract is checked against findings the linter
    actually emits, not a hand-written list."""

    def __init__(self, path: pathlib.Path):
        self.data = json.loads(path.read_text())
        self.violations = self.data.get("violations", [])

    def matches(self, rule=None, symbol=None, severity=None, file=None) -> list[dict]:
        out = []
        for v in self.violations:
            if rule is not None and v.get("rule") != rule:
                continue
            if symbol is not None and v.get("symbol") != symbol:
                continue
            if severity is not None and v.get("severity") != severity:
                continue
            if file is not None and v.get("file") != file:
                continue
            out.append(v)
        return out


def verify_lintcrux_checkpoint(rep: LintReport, cp: dict, add) -> None:
    name = cp.get("name", "<unnamed>")
    st = (cp.get("tool_states") or {}).get("lintcrux") or {}

    # Specific findings that must be present. Each is a partial match on
    # rule/symbol/severity/file — a triage lab asserts "there is an UNUSEDSIGNAL
    # on debug_count", not the entire report.
    for want in st.get("violations_present") or []:
        hits = rep.matches(rule=want.get("rule"), symbol=want.get("symbol"),
                           severity=want.get("severity"), file=want.get("file"))
        desc = " ".join(f"{k}={v}" for k, v in want.items())
        add(f"checkpoint {name}: a violation with {desc}", bool(hits),
            "" if hits else "no matching violation in the report")

    # Per-rule floor. `min_rule_counts` rather than exact, because a newer engine
    # version may legitimately add findings; a triage lab must not go red for
    # that. Exact counts would make the pack fragile across linter versions.
    for rule, want in (st.get("min_rule_counts") or {}).items():
        got = len(rep.matches(rule=rule))
        add(f"checkpoint {name}: at least {want}× {rule}", got >= want,
            "" if got >= want else f"report has {got}")

    for rule in st.get("rules_present") or []:
        got = len(rep.matches(rule=rule))
        add(f"checkpoint {name}: {rule} is reported", got > 0,
            "" if got > 0 else "rule not present")


class TestResults:
    """Normalised regression results — what a SimCrux dashboard renders.
    Produced by a pack's build.sh from a real simulator run (e.g. iverilog),
    so the contract is checked against outcomes the testbench actually reported."""

    def __init__(self, path: pathlib.Path):
        self.data = json.loads(path.read_text())
        self.tests = self.data.get("tests", [])

    @classmethod
    def empty(cls) -> "TestResults":
        """No regression results: a Flow pack's checkpoints read run directories."""
        self = cls.__new__(cls)
        self.data, self.tests = {}, []
        return self

    def by_name(self, name: str) -> dict | None:
        for t in self.tests:
            if t.get("name") == name:
                return t
        return None

    def count(self, outcome: str) -> int:
        return sum(1 for t in self.tests if t.get("outcome") == outcome)


def verify_simcrux_checkpoint(res: TestResults, cp: dict, add) -> None:
    name = cp.get("name", "<unnamed>")
    st = (cp.get("tool_states") or {}).get("simcrux") or {}

    tt = st.get("total_tests")
    if tt is not None:
        add(f"checkpoint {name}: suite has {tt} tests", len(res.tests) == tt,
            "" if len(res.tests) == tt else f"results have {len(res.tests)}")

    for outcome, want in (st.get("outcome_counts") or {}).items():
        got = res.count(outcome)
        add(f"checkpoint {name}: {want} test(s) {outcome}", got == want,
            "" if got == want else f"results have {got}")

    # Named tests with an expected outcome — "the add_carry test passes",
    # "random_stress is flaky". Optional seed floors keep a flaky classification
    # honest without pinning the exact (RNG-stable but noisy) seed split.
    for want in st.get("tests") or []:
        tn, outcome = want.get("name"), want.get("outcome")
        t = res.by_name(tn)
        if t is None:
            add(f"checkpoint {name}: test {tn} is in the suite", False, "not found")
            continue
        if outcome is not None:
            add(f"checkpoint {name}: test {tn} is {outcome}", t.get("outcome") == outcome,
                "" if t.get("outcome") == outcome else f"it is {t.get('outcome')}")
        mp = want.get("min_pass_seeds")
        if mp is not None:
            got = len(t.get("pass_seeds") or [])
            add(f"checkpoint {name}: {tn} passes on ≥{mp} seed(s)", got >= mp,
                "" if got >= mp else f"passes on {got}")
        mf = want.get("min_fail_seeds")
        if mf is not None:
            got = len(t.get("fail_seeds") or [])
            add(f"checkpoint {name}: {tn} fails on ≥{mf} seed(s)", got >= mf,
                "" if got >= mf else f"fails on {got}")


# ── SimCrux Flow state ───────────────────────────────────────────────────────
#
# A Flow pack's ground truth is a flow RUN DIRECTORY committed under
# fixtures/flow/, the directory SimCrux's Flow Runs panel ingests. Every
# expectation is recomputed here from the run's own files (the tool's report,
# its log, its metrics, its step directories, the RTL), never from anything
# SimCrux displays. The vocabulary is edu-pack-spec.md section 4.4.

FLOW_VERDICTS = ("met", "violated", "stopped", "not_run", "unrecognised")
FLOW_STEP_STATUSES = ("completed", "failed", "skipped", "running", "not_started")
# Statuses a directory listing can establish. skipped and running are written
# by a run's own error and process records, which a committed fixture has no
# reliable copy of, so an expectation of either is reported as declared only.
# not_started stays in the list so that an expectation of it is checked, and
# fails: a step directory exists only once its step began.
_FLOW_STEP_DERIVABLE = ("completed", "failed", "not_started")
_FLOW_KEYS = {"run", "kind", "verdict", "steps", "metrics", "worst_path",
              "mapped_register"}

_MAX_FREQ = re.compile(
    r"Max frequency for clock '([^']*)': ([\d.]+) MHz "
    r"\((PASS|FAIL) at ([\d.]+) MHz\)")
_LL_STEP_DIR = re.compile(r"^(\d+)-([A-Za-z0-9_.-]+)$")
_STA_START = re.compile(r"^\s*Startpoint:\s*(\S+)", re.M)
_STA_END = re.compile(r"^\s*Endpoint:\s*(\S+)", re.M)
_STA_SLACK = re.compile(r"^\s*(-?[\d.]+)\s+slack \((MET|VIOLATED)\)", re.M)

# The LibreLane metrics whose value decides a completed run, as a reader of the
# run reads them: a worst slack below zero, or a violation count above zero.
LL_VERDICT_SLACK_KEYS = ("timing__setup__ws", "timing__hold__ws")
LL_VERDICT_COUNT_KEYS = (
    "timing__setup_vio__count", "timing__hold_vio__count", "route__drc_errors",
    "magic__drc_error__count", "design__lvs_error__count",
    "route__antenna_violation__count", "antenna__violating__nets",
    "design__xor_difference__count")


class FlowRunDir:
    """A flow run directory read straight from its files.

    kind is `nextpnr` (a report.json and/or pnr.log) or `librelane`
    (resolved.json, final/, or numbered step directories); None when the
    directory is neither.
    """

    def __init__(self, root: pathlib.Path):
        self.root = root
        self.problem: str | None = None
        self.report: dict | None = None
        self.log_clocks: dict[str, tuple[float, str, float]] = {}
        self.metrics: dict | None = None
        if (root / "report.json").is_file() or (root / "pnr.log").is_file():
            self.kind = "nextpnr"
            self._read_nextpnr()
        elif self._looks_like_librelane():
            self.kind = "librelane"
            self._read_librelane()
        else:
            self.kind = None

    # -- nextpnr ---------------------------------------------------------------

    def _read_nextpnr(self) -> None:
        rp = self.root / "report.json"
        if rp.is_file():
            try:
                self.report = json.loads(rp.read_text())
            except json.JSONDecodeError as e:
                self.problem = f"report.json is not valid JSON: {e}"
        lp = self.root / "pnr.log"
        if lp.is_file():
            # The LAST line per clock is the final, post-route figure; earlier
            # lines are pre-route estimates.
            for m in _MAX_FREQ.finditer(lp.read_text(errors="replace")):
                self.log_clocks[m.group(1)] = (
                    float(m.group(2)), m.group(3), float(m.group(4)))

    def report_clocks(self) -> dict[str, tuple[float, float]] | None:
        """clock -> (achieved MHz, constraint MHz) from report.json `fmax`."""
        if not isinstance(self.report, dict):
            return None
        fmax = self.report.get("fmax")
        if not isinstance(fmax, dict):
            return None
        out = {}
        for name, v in fmax.items():
            try:
                out[name] = (float(v["achieved"]), float(v["constraint"]))
            except (KeyError, TypeError, ValueError):
                return None
        return out

    def nextpnr_verdict(self) -> str:
        """met iff every clock reaches its constraint, from the report; the log
        when there is no report. Never the exit status."""
        clocks = self.report_clocks()
        if clocks is not None:
            if not clocks:
                return "unrecognised"
            return "met" if all(a >= c for a, c in clocks.values()) else "violated"
        if self.report is None and self.log_clocks:
            return ("met" if all(t == "PASS" for _, t, _ in self.log_clocks.values())
                    else "violated")
        if self.report is None and not (self.root / "pnr.log").is_file():
            return "not_run"
        return "unrecognised"

    def nextpnr_metric(self, key: str) -> float | None:
        clocks = self.report_clocks()
        if clocks is None:
            return None
        if key == "fmax__achieved__mhz":
            return min(a for a, _ in clocks.values()) if clocks else None
        if key == "timing__setup__wns":
            # period slack per clock: 1000/constraint - 1000/achieved ns
            return min(1000 / c - 1000 / a for a, c in clocks.values()) if clocks else None
        m = re.fullmatch(r"utilization__(used|available)__bel:(.+)", key)
        if m and isinstance(self.report, dict):
            u = (self.report.get("utilization") or {}).get(m.group(2))
            if isinstance(u, dict) and isinstance(u.get(m.group(1)), (int, float)):
                return float(u[m.group(1)])
        return None

    def nextpnr_path(self, rank: int) -> dict | None:
        paths = (self.report or {}).get("critical_paths") if isinstance(self.report, dict) else None
        if not isinstance(paths, list) or not 1 <= rank <= len(paths):
            return None
        return paths[rank - 1]

    # -- LibreLane -------------------------------------------------------------

    def _looks_like_librelane(self) -> bool:
        r = self.root
        if (r / "resolved.json").is_file() or (r / "final").is_dir():
            return True
        return any(c.is_dir() and _LL_STEP_DIR.match(c.name) for c in r.iterdir()) \
            if r.is_dir() else False

    def _read_librelane(self) -> None:
        mp = self.root / "final" / "metrics.json"
        if mp.is_file():
            try:
                data = json.loads(mp.read_text())
                if isinstance(data, dict):
                    self.metrics = data
                else:
                    self.problem = "final/metrics.json is not a JSON object"
            except json.JSONDecodeError as e:
                self.problem = f"final/metrics.json is not valid JSON: {e}"

    def steps(self) -> list[tuple[int, str, str]]:
        """(ordinal, id, status) for each numbered step directory. The id is the
        directory name without its number (`06-yosys-synthesis` is
        `yosys-synthesis`). A step is completed when it wrote state_out.json
        and failed when it did not: a step directory exists only once the step
        began, so one without state_out.json either stopped the flow (the
        newest directory, no final metrics) or was a checker whose error
        LibreLane deferred to the end (later steps ran). SimCrux reads the
        same records the same way."""
        found = []
        for c in self.root.iterdir():
            m = _LL_STEP_DIR.match(c.name) if c.is_dir() else None
            if m:
                done = (c / "state_out.json").is_file()
                found.append([int(m.group(1)), m.group(2),
                              "completed" if done else "failed"])
        found.sort(key=lambda s: s[0])
        return [tuple(s) for s in found]

    def librelane_metric(self, key: str) -> float | None:
        """The exact key; else the fold of its corner-qualified keys: the minimum
        for worst slacks, the sum for counts. Anything else is ambiguous and a
        pack must name the exact key."""
        if not isinstance(self.metrics, dict):
            return None
        v = self.metrics.get(key)
        if isinstance(v, (int, float)) and not isinstance(v, bool):
            return float(v)
        folded = [float(x) for k, x in self.metrics.items()
                  if k.startswith(key + "__") and isinstance(x, (int, float))
                  and not isinstance(x, bool)]
        if not folded:
            return None
        if key.endswith(("__ws", "__wns")):
            return min(folded)
        if "count" in key or key.endswith("errors"):
            return float(sum(folded))
        return None

    def librelane_verdict(self) -> str:
        if self.metrics is None:
            return "unrecognised" if self.problem else "stopped"
        seen = False
        for k in LL_VERDICT_SLACK_KEYS:
            v = self.librelane_metric(k)
            if v is None:
                continue
            seen = True
            if v < 0:
                return "violated"
        for k in LL_VERDICT_COUNT_KEYS:
            v = self.librelane_metric(k)
            if v is None:
                continue
            seen = True
            if v > 0:
                return "violated"
        return "met" if seen else "unrecognised"

    # -- either kind -----------------------------------------------------------

    def verdict(self) -> str:
        if self.kind == "nextpnr":
            return self.nextpnr_verdict()
        if self.kind == "librelane":
            return self.librelane_verdict()
        return "unrecognised"

    def metric(self, key: str) -> float | None:
        if self.kind == "nextpnr":
            return self.nextpnr_metric(key)
        if self.kind == "librelane":
            return self.librelane_metric(key)
        return None


def _contained(pack: pathlib.Path, rel: str) -> pathlib.Path | None:
    """`rel` resolved inside the pack, or None when it escapes (absolute, a `..`
    segment, or a symlink out)."""
    if not isinstance(rel, str) or not rel or pathlib.PurePath(rel).is_absolute():
        return None
    p = (pack / rel).resolve()
    try:
        p.relative_to(pack.resolve())
    except ValueError:
        return None
    return p


def verify_flow_state(pack: pathlib.Path, name: str, flow: dict, add) -> None:
    """Verify one checkpoint's `tool_states.simcrux.flow` against its run."""
    unknown = sorted(set(flow) - _FLOW_KEYS)
    if unknown:
        add(f"checkpoint {name}: flow fields are known", False,
            f"unknown: {unknown}; known: {sorted(_FLOW_KEYS)}")
    rel = flow.get("run")
    run_dir = _contained(pack, rel) if rel is not None else None
    label = f"checkpoint {name}: flow run {rel}"
    if rel is None:
        add(f"checkpoint {name}: flow names its run directory", False, "no flow.run")
        return
    if run_dir is None:
        add(f"{label} is inside the pack", False, "absolute path, `..` or a symlink out")
        return
    if not run_dir.is_dir():
        add(f"{label} exists", False, "no such directory")
        return
    run = FlowRunDir(run_dir)
    if run.kind is None:
        add(f"{label} is a flow run", False,
            "neither a nextpnr report/log nor a LibreLane run layout")
        return
    add(f"{label} is a {run.kind} run", True)
    if run.problem:
        add(f"{label} is readable", False, run.problem)
        return

    want_kind = flow.get("kind")
    if want_kind is not None:
        add(f"checkpoint {name}: run kind is {want_kind}", run.kind == want_kind,
            "" if run.kind == want_kind else f"the run is {run.kind}")

    if "verdict" in flow:
        want = flow["verdict"]
        if want not in FLOW_VERDICTS:
            add(f"checkpoint {name}: verdict {want!r} is a verdict token", False,
                f"one of {FLOW_VERDICTS}")
        else:
            got = run.verdict()
            add(f"checkpoint {name}: verdict is {want}", got == want,
                "" if got == want else f"the run's own files say {got}")
            if run.kind == "nextpnr":
                _check_nextpnr_log_agrees(name, run, want, add)

    if "steps" in flow:
        _check_steps(name, run, flow["steps"], add)
    for m in flow.get("metrics") or []:
        _check_metric(name, run, m, add)
    if "worst_path" in flow:
        _check_worst_path(name, run, flow["worst_path"], add)
    if "mapped_register" in flow:
        _check_mapped_register(pack, name, run, flow["mapped_register"], add)


def _check_nextpnr_log_agrees(name: str, run: FlowRunDir, want: str, add) -> None:
    """The report and the log are two witnesses of one run: the final
    `Max frequency` line must say what the report says."""
    if not run.log_clocks or run.report_clocks() is None:
        return
    log_says = ("met" if all(t == "PASS" for _, t, _ in run.log_clocks.values())
                else "violated")
    add(f"checkpoint {name}: the log's final Max frequency lines agree "
        f"({want})", log_says == want,
        "" if log_says == want else f"the log says {log_says}")


def _check_steps(name: str, run: FlowRunDir, want_steps, add) -> None:
    if run.kind != "librelane":
        add(f"checkpoint {name}: steps apply to a LibreLane run", False,
            "a nextpnr run has no step directories")
        return
    have = {sid: st for _, sid, st in run.steps()}
    for w in want_steps or []:
        sid, st = w.get("id"), w.get("status")
        label = f"checkpoint {name}: step {sid} is {st}"
        if st not in FLOW_STEP_STATUSES:
            add(label, False, f"status must be one of {FLOW_STEP_STATUSES}")
        elif sid not in have:
            add(label, False, f"steps present: {sorted(have)}")
        elif st not in _FLOW_STEP_DERIVABLE:
            add(label + " (declared only)", True,
                "skipped and running are not derivable from a committed run")
        else:
            add(label, have[sid] == st,
                "" if have[sid] == st else f"the step directory says {have[sid]}")


def _check_metric(name: str, run: FlowRunDir, m: dict, add) -> None:
    key = m.get("key")
    got = run.metric(key) if isinstance(key, str) else None
    bounds = [f"{k}={m[k]}" for k in ("min", "max", "equals") if k in m]
    label = f"checkpoint {name}: metric {key} within {' '.join(bounds) or 'nothing'}"
    if got is None:
        add(label, False, "the run's own files give no value for this key")
        return
    ok = True
    if "min" in m:
        ok = ok and got >= float(m["min"])
    if "max" in m:
        ok = ok and got <= float(m["max"])
    if "equals" in m:
        ok = ok and got == float(m["equals"])
    add(label, ok and bool(bounds), f"the run says {got}")


def _check_worst_path(name: str, run: FlowRunDir, wp: dict, add) -> None:
    label = f"checkpoint {name}: worst path"
    report_rel = wp.get("report")
    if report_rel is not None:
        # An OpenSTA-format text report inside the run: the first path block.
        p = _contained(run.root, report_rel)
        if p is None or not p.is_file():
            add(f"{label} report {report_rel} exists in the run", False, "missing")
            return
        text = p.read_text(errors="replace")
        start, end = _STA_START.search(text), _STA_END.search(text)
        slack = _STA_SLACK.search(text)
        if not (start and end):
            add(f"{label} report names a Startpoint and an Endpoint", False,
                "no Startpoint: / Endpoint: lines")
            return
        for field, m in (("startpoint", start), ("endpoint", end)):
            if field in wp:
                add(f"{label} {field} is {wp[field]}", m.group(1) == wp[field],
                    "" if m.group(1) == wp[field] else f"the report says {m.group(1)}")
        if "slack" in wp:
            got = slack.group(2).lower() if slack else None
            add(f"{label} slack is {wp['slack']}", got == wp["slack"],
                f"the report says {got}")
        return
    if run.kind != "nextpnr":
        add(f"{label} names a report file", False,
            "a LibreLane run needs worst_path.report (a run-relative path report)")
        return
    path = run.nextpnr_path(int(wp.get("rank", 1)))
    if path is None:
        add(f"{label} rank {wp.get('rank', 1)} exists", False, "report lists fewer paths")
        return
    steps = path.get("path") or []
    cells = [(s.get("from") or {}).get("cell") for s in steps if s.get("type") != "source"]
    ends = [(s.get("to") or {}).get("cell") for s in steps]
    got_start, got_end = (cells[0] if cells else None), (ends[-1] if ends else None)
    for field, got in (("startpoint", got_start), ("endpoint", got_end)):
        if field in wp:
            add(f"{label} {field} is {wp[field]}", got == wp[field],
                "" if got == wp[field] else f"the report says {got}")
    if "slack" in wp:
        add(f"{label} slack is stated", False,
            "nextpnr's report states no per-path slack; use metrics")
    if "delay_ns" in wp:
        total = sum(float(s.get("delay", 0)) for s in steps)
        lo, hi = wp["delay_ns"].get("min"), wp["delay_ns"].get("max")
        ok = (lo is None or total >= lo) and (hi is None or total <= hi)
        add(f"{label} delay_ns within [{lo}, {hi}]", ok, f"the segments sum to {total:.3f}")
    for st in wp.get("segment_types") or []:
        present = any(s.get("type") == st for s in steps)
        add(f"{label} has a {st} segment", present,
            "" if present else f"types present: {sorted({s.get('type') for s in steps})}")


def _span_hits(strings, source_name: str, line: int) -> bool:
    """Whether any Yosys `file:line.col-line.col` span (with `|`-joined lists)
    in `strings` starts on `line` of the file named `source_name`."""
    want = re.compile(rf"(?:^|[|/]){re.escape(source_name)}:{line}\.")
    return any(want.search(s) for s in strings if isinstance(s, str))


def _check_mapped_register(pack: pathlib.Path, name: str, run: FlowRunDir,
                           mr: dict, add) -> None:
    """The register behind a worst path's ends, and the RTL line that computes
    it. Expectations come from the RTL's meaning (which register a statement
    assigns); the run's files are only asked whether they agree."""
    label = f"checkpoint {name}: mapped register"
    if run.kind != "nextpnr":
        add(f"{label} applies to a nextpnr run", False,
            "SimCrux maps worst paths of nextpnr runs only")
        return
    src_rel = mr.get("source")
    src = _contained(pack, src_rel) if src_rel else None
    if src is None or not src.is_file():
        add(f"{label} source {src_rel} exists in the pack", False, "missing")
        return
    lines = src.read_text().splitlines()
    starts = mr.get("start_registers") or []
    end = mr.get("end_register")
    stmt = mr.get("statement_line")
    decls = mr.get("declaration_lines") or {}

    for reg, n in decls.items():
        ok = 1 <= n <= len(lines) and re.search(rf"\b{re.escape(reg)}\b", lines[n - 1]) \
            and re.search(r"\b(reg|logic)\b", lines[n - 1]) is not None
        add(f"{label} {reg} is declared on {src_rel} line {n}", bool(ok),
            "" if ok else f"line {n} is {lines[n - 1].strip() if 1 <= n <= len(lines) else 'past the end'!r}")
    if stmt is not None:
        ok = (1 <= stmt <= len(lines)
              and re.search(rf"\b{re.escape(end or '')}\b\s*<=", lines[stmt - 1]) is not None)
        add(f"{label} {end} is assigned on {src_rel} line {stmt}", ok,
            "" if ok else "that line does not assign it with <=")

    path = run.nextpnr_path(int(mr.get("rank", 1)))
    if path is None:
        add(f"{label} the run lists a path to map", False, "no critical path")
        return
    steps = path.get("path") or []
    cells = [(s.get("from") or {}).get("cell") for s in steps if s.get("type") != "source"]
    got_start = cells[0] if cells else ""
    got_end = (steps[-1].get("to") or {}).get("cell") if steps else ""
    spans = [x for s in steps for x in (s.get("sources") or [])]

    def descends(cell: str, reg: str) -> bool:
        # iCE40, ECP5 and Gowin cell names carry the RTL register name.
        return isinstance(cell, str) and cell.startswith(reg + "_")

    start_hit = next((r for r in starts if descends(got_start, r)), None)
    start_how = "cell name"
    if start_hit is None:
        # GateMate-style opaque cell names: the routing step's source spans
        # carry the declaration line.
        start_hit = next((r for r in starts if r in decls
                          and _span_hits(spans, src.name, decls[r])), None)
        start_how = "source span"
    add(f"{label} the worst path starts at one of {starts}", start_hit is not None,
        f"start cell is {got_start!r}" if start_hit is None
        else f"{start_hit} via {start_how}")

    end_ok = descends(got_end, end or "")
    end_how = "cell name"
    if not end_ok and stmt is not None:
        end_ok = _span_hits(spans, src.name, stmt)
        end_how = "source span"
    add(f"{label} the worst path ends at {end}", end_ok,
        f"end cell is {got_end!r}" if not end_ok else f"via {end_how}")

    # SimCrux maps a path only against the run's synthesised netlist, named
    # synth.json. Without it the same run lists its worst path unmapped.
    synth = run.root / "synth.json"
    if not synth.is_file():
        add(f"{label} the run holds synth.json for SimCrux to map against", False,
            "without synth.json the Flow Runs panel lists the path unmapped")
        return
    add(f"{label} the run holds synth.json for SimCrux to map against", True)
    if stmt is not None:
        try:
            net = json.loads(synth.read_text())
        except json.JSONDecodeError as e:
            add(f"{label} synth.json is valid JSON", False, str(e))
            return
        srcs = [c.get("attributes", {}).get("src") for m in net.get("modules", {}).values()
                for c in m.get("cells", {}).values()]
        add(f"{label} synth.json has a cell from {src.name} line {stmt}",
            _span_hits(srcs, src.name, stmt),
            "no cell attribute `src` starts on that line")


def verify_wavecrux_checkpoint(vcd: "Vcd", cp: dict, add) -> None:
    name = cp.get("name", "<unnamed>")
    t = cp.get("time_ns")
    sv = ((cp.get("tool_states") or {}).get("wavecrux") or {}).get("signal_values") or {}
    if not sv:
        return
    if t is None:
        add(f"checkpoint {name}: has time_ns", False)
        return
    for path, lit in sv.items():
        label = f"checkpoint {name} @ {t}ns: {path} == {lit}"
        actual_raw = vcd.value_at(path, float(t))
        if actual_raw is None:
            add(label, False, "signal absent from VCD or no value at that time")
            continue
        width, want, want_unknown = parse_expected(str(lit))
        if width is None:
            add(label, False, f"cannot parse expected literal {lit!r}")
            continue
        got, got_unknown = vcd_to_int(actual_raw)
        if want_unknown or got_unknown:
            add(label, want_unknown and got_unknown, f"waveform has {actual_raw!r}")
            continue
        add(label, got == want, "" if got == want else
            f"waveform has {actual_raw!r} (={got}), contract wants {want}")


def verify_netcrux_checkpoint(nl: Netlist, cp: dict, add) -> None:
    name = cp.get("name", "<unnamed>")
    st = (cp.get("tool_states") or {}).get("netcrux") or {}
    module = st.get("module")
    if not module:
        add(f"checkpoint {name}: names a module", False, "no netcrux.module")
        return
    if not nl.has_module(module):
        add(f"checkpoint {name}: module {module} exists", False,
            "not in the netlist")
        return
    add(f"checkpoint {name}: module {module} exists", True)

    for pname, want in (st.get("ports") or {}).items():
        got = nl.port(module, pname)
        label = f"checkpoint {name}: {module}.{pname} is {want.get('direction')}[{want.get('width')}]"
        if got is None:
            add(label, False, "port absent")
            continue
        ok = (got["direction"] == want.get("direction")
              and got["width"] == want.get("width"))
        add(label, ok, "" if ok else f"netlist has {got['direction']}[{got['width']}]")

    present = nl.cell_types(module)
    for ct in st.get("cell_types_present") or []:
        add(f"checkpoint {name}: {module} contains a {ct} cell", ct in present,
            "" if ct in present else f"cells present: {sorted(present)}")

    subs = nl.submodules(module)
    for sm in st.get("submodules_present") or []:
        add(f"checkpoint {name}: {module} instantiates {sm}", sm in subs,
            "" if sm in subs else f"submodules present: {sorted(subs)}")

    # Exact instance counts — how a fan-out lesson pins "there are two of these".
    for ctype, want in (st.get("instance_counts") or {}).items():
        got = nl.instance_count(module, ctype)
        add(f"checkpoint {name}: {module} has {want}× {ctype}", got == want,
            "" if got == want else f"netlist has {got}")


# `src/counter_buggy.v` line 21   or   [`../src/x.v`](../src/x.v) line 21
_LINE_REF = re.compile(
    r"`((?:\.\./)*[\w./-]+\.(?:v|sv|vh|svh|vhd|vhdl|py))`"
    r"(?:\]\([^)]*\))?\s+line\s+(\d+)")
_BUG_MARKER = re.compile(r"<--\s*BUG")
# How far below a reference a quoted code block may start and still be taken
# as a quotation of the referenced line.
_QUOTE_WINDOW = 6


def _norm(code: str) -> str:
    return " ".join(code.split())


def verify_source_line_refs(pack: pathlib.Path, add) -> None:
    """A handout or solution that says "the bug is on line 21" must point at
    the line that holds it. Nothing tied those numbers to the source, so an
    edit above the bug (or a miscount) left the answer key wrong. For every
    `file` line N reference in the pack's Markdown:

    - the file exists and has a non-blank line N;
    - if the file marks lines with `<-- BUG`, line N is one of them;
    - if a fenced code block starts within a few lines below the reference,
      its first line is what line N actually says.
    """
    for md in sorted(pack.rglob("*.md")):
        lines = md.read_text().splitlines()
        for i, text in enumerate(lines):
            for m in _LINE_REF.finditer(text):
                rel, n = m.group(1), int(m.group(2))
                where = f"{md.relative_to(pack)}:{i + 1}"
                label = f"{where} cites {rel.lstrip('./')} line {n}"
                src = (md.parent / rel).resolve()
                if not src.is_file():
                    src = (pack / rel.lstrip("./")).resolve()
                if not src.is_file():
                    add(label, False, "file not found")
                    continue
                src_lines = src.read_text().splitlines()
                if not 1 <= n <= len(src_lines) or not src_lines[n - 1].strip():
                    add(label, False, f"line {n} is blank or past the end "
                                      f"({len(src_lines)} lines)")
                    continue
                cited = src_lines[n - 1]
                marked = [k + 1 for k, s in enumerate(src_lines) if _BUG_MARKER.search(s)]
                if marked and n not in marked:
                    add(label, False, f"the BUG marker is on line(s) {marked}; "
                                      f"line {n} is {cited.strip()!r}")
                    continue
                quote = None
                for j in range(i + 1, min(i + 1 + _QUOTE_WINDOW, len(lines))):
                    if lines[j].lstrip().startswith("```"):
                        body = [b for b in lines[j + 1:] if b.strip()]
                        if body and not body[0].lstrip().startswith("```"):
                            quote = body[0]
                        break
                if quote is not None:
                    q = _norm(quote)
                    ok = q in _norm(cited)
                    add(label, ok, "" if ok else
                        f"quoted {q!r} but line {n} is {cited.strip()!r}")
                    continue
                add(label, True)


class Result:
    def __init__(self, pack: str):
        self.pack = pack
        self.checks: list[tuple[str, bool, str]] = []

    def add(self, name: str, ok: bool, detail: str = "") -> None:
        self.checks.append((name, ok, detail))

    @property
    def failures(self):
        return [c for c in self.checks if not c[1]]

    @property
    def ok(self) -> bool:
        return not self.failures


def verify_pack(pack: pathlib.Path) -> Result:
    r = Result(pack.name)

    # ── structure ────────────────────────────────────────────────────────────
    manifest_path = pack / "pack.yaml"
    if not manifest_path.exists():
        r.add("pack.yaml exists", False, "missing")
        return r
    r.add("pack.yaml exists", True)

    manifest = manifest_path.read_text()
    pack_id = None
    m = re.search(r"^pack_id:\s*(\S+)", manifest, re.M)
    if m:
        pack_id = m.group(1).strip().strip("\"'")
    r.add("pack.yaml declares pack_id", pack_id is not None)
    if pack_id is not None:
        r.add("pack_id matches directory name", pack_id == pack.name,
              f"pack_id={pack_id!r} dir={pack.name!r}")
    r.add("pack.yaml declares schema_version: 1",
          re.search(r"^schema_version:\s*1\b", manifest, re.M) is not None)

    # Which product's fixture a pack carries determines how its checkpoints are
    # verified. A WaveCrux pack replays a VCD; a NetCrux pack reads a Yosys JSON
    # netlist; and so on. Detect it from the required_tools declaration rather
    # than guessing from filenames.
    tools = re.findall(r"product:\s*(\S+)", manifest)
    primary_tool = tools[0].strip().strip("\"'") if tools else "wavecrux"

    # A pack may require more than one tool (Tier B/C). Each required tool
    # brings its own ground-truth fixture; a multi-tool pack is verified against
    # every one of them.
    all_tools = [t.strip().strip("\"'") for t in tools] or ["wavecrux"]

    common = ("student/handout.md", "instructor/notes.md", "README.md",
              "fixtures/expected.json")
    fixture_by_tool = {
        "wavecrux": "fixtures/reference.vcd",
        "netcrux": "fixtures/netlist.json",
        "lintcrux": "fixtures/lint.json",
        "simcrux": "fixtures/results.json",
    }
    # A SimCrux pack carries either a regression's results.json or, for a Flow
    # pack, a fixtures/flow/ directory of run directories.
    flow_pack = "simcrux" in all_tools and (pack / "fixtures" / "flow").is_dir()
    if flow_pack:
        fixture_by_tool = dict(fixture_by_tool, simcrux="fixtures/flow")
    required_fixtures = tuple(fixture_by_tool[t] for t in all_tools
                              if t in fixture_by_tool)
    for rel in common + required_fixtures:
        r.add(f"{rel} present", (pack / rel).exists())

    # ── answer keys that cite source line numbers ────────────────────────────
    verify_source_line_refs(pack, r.add)

    # ── session (WaveCrux packs only) ────────────────────────────────────────
    sess_path = pack / "fixtures" / "reference.wavecrux"
    vcd_path = pack / "fixtures" / "reference.vcd"
    vcd = Vcd(vcd_path) if vcd_path.exists() else None

    if primary_tool == "wavecrux" and sess_path.exists():
        try:
            sess = json.loads(sess_path.read_text())
        except json.JSONDecodeError as e:
            r.add("reference.wavecrux is valid JSON", False, str(e))
            sess = None
        else:
            r.add("reference.wavecrux is valid JSON", True)
            r.add("session is not a _TODO placeholder", "_TODO" not in sess)
            r.add(f"session schema version is {SESSION_SCHEMA_VERSION}",
                  sess.get("version") == SESSION_SCHEMA_VERSION,
                  f"got {sess.get('version')!r}")
            rows = sess.get("signals") or []
            r.add("session has at least one signal row", len(rows) > 0)
            bad_fmt = [s.get("format") for s in rows
                       if s.get("format") and s["format"] not in VALID_FORMATS]
            r.add("every session row uses a real DisplayFormat", not bad_fmt,
                  f"invalid: {sorted(set(bad_fmt))}" if bad_fmt else "")
            if vcd is not None:
                missing = [s.get("path") for s in rows
                           if s.get("path") and s["path"] not in vcd.path_to_id]
                # A row whose path is absent is dropped silently on load, so
                # this is the difference between a working session and an
                # empty-looking one.
                r.add("every session signal path exists in the VCD", not missing,
                      f"absent: {missing}" if missing else "")
    elif primary_tool == "wavecrux":
        r.add("reference.wavecrux present", False, "missing")

    # ── the contract: checkpoints vs the tool's ground-truth fixture ─────────
    exp_path = pack / "fixtures" / "expected.json"
    if not exp_path.exists():
        return r
    try:
        exp = json.loads(exp_path.read_text())
    except json.JSONDecodeError as e:
        r.add("expected.json is valid JSON", False, str(e))
        return r
    r.add("expected.json is valid JSON", True)
    if pack_id:
        r.add("expected.json pack_id matches", exp.get("pack_id") == pack_id,
              f"got {exp.get('pack_id')!r}")
    checkpoints = exp.get("checkpoints") or []
    r.add("expected.json declares checkpoints", len(checkpoints) > 0)

    # Load each required tool's fixture once. A checkpoint's tool_states may name
    # any of these; a multi-tool pack references several.
    loaders = {}
    if "netcrux" in all_tools:
        p = pack / "fixtures" / "netlist.json"
        if p.exists():
            try:
                loaders["netcrux"] = Netlist(p)
                r.add("netlist.json is a valid Yosys netlist", True)
            except (json.JSONDecodeError, KeyError) as e:
                r.add("netlist.json is a valid Yosys netlist", False, str(e))
    if "lintcrux" in all_tools:
        p = pack / "fixtures" / "lint.json"
        if p.exists():
            try:
                loaders["lintcrux"] = LintReport(p)
                r.add("lint.json is valid JSON", isinstance(loaders["lintcrux"].violations, list))
            except json.JSONDecodeError as e:
                r.add("lint.json is valid JSON", False, str(e))
    if "simcrux" in all_tools:
        p = pack / "fixtures" / "results.json"
        if p.exists():
            try:
                loaders["simcrux"] = TestResults(p)
                r.add("results.json is valid JSON", isinstance(loaders["simcrux"].tests, list))
            except json.JSONDecodeError as e:
                r.add("results.json is valid JSON", False, str(e))
        elif flow_pack:
            # No regression results; the Flow state checks read the runs.
            loaders["simcrux"] = TestResults.empty()
    if "wavecrux" in all_tools and vcd is not None:
        loaders["wavecrux"] = vcd

    def verify_simcrux(res, cp, add):
        verify_simcrux_checkpoint(res, cp, add)
        flow = ((cp.get("tool_states") or {}).get("simcrux") or {}).get("flow")
        if flow is not None:
            verify_flow_state(pack, cp.get("name", "<unnamed>"), flow, add)

    dispatch = {
        "wavecrux": verify_wavecrux_checkpoint,
        "netcrux": verify_netcrux_checkpoint,
        "lintcrux": verify_lintcrux_checkpoint,
        "simcrux": verify_simcrux,
    }

    # Each checkpoint's tool_states is verified against every tool it names, so a
    # cross-tool pack's per-tool assertions are all checked.
    for cp in checkpoints:
        states = cp.get("tool_states") or {}
        for tool in states:
            fn = dispatch.get(tool)
            if fn is None:
                r.add(f"checkpoint {cp.get('name','?')}: unknown tool {tool!r}", False)
                continue
            fixture = loaders.get(tool)
            if fixture is None:
                r.add(f"checkpoint {cp.get('name','?')}: {tool} fixture available",
                      False, f"no fixture loaded for {tool}")
                continue
            fn(fixture, cp, r.add)

    # ── cross-tool deep links: DECLARED, not machine-verified ────────────────
    # These are the Tier B/C payload — a source action in one tool that lands in
    # another over CXP. Executing them needs two running apps driven under
    # automation, which only WaveCrux (WCP) currently exposes, so the verifier
    # checks the DECLARATION is well-formed and records — visibly, not silently —
    # that it was not exercised.
    for i, link in enumerate(exp.get("cross_tool_deep_links") or []):
        need = ("source_tool", "source_action", "target_tool", "expected_target_state")
        missing = [k for k in need if k not in link]
        label = f"deep-link {link.get('name', i)}: declaration is well-formed"
        r.add(label, not missing, f"missing fields: {missing}" if missing else "")
        # A non-failing marker so the gap is impossible to miss in the output.
        r.add(f"deep-link {link.get('name', i)}: NOT machine-verified "
              f"({link.get('source_tool','?')} → {link.get('target_tool','?')}) "
              f"— needs a driver surface on both tools", True,
              "declared only; end-to-end execution not yet automatable")

    return r


def to_junit(results: list[Result]) -> str:
    suites = ET.Element("testsuites")
    for r in results:
        s = ET.SubElement(suites, "testsuite", name=r.pack,
                          tests=str(len(r.checks)), failures=str(len(r.failures)))
        for name, ok, detail in r.checks:
            c = ET.SubElement(s, "testcase", classname=r.pack, name=name)
            if not ok:
                f = ET.SubElement(c, "failure", message=detail or "failed")
                f.text = detail
    return ET.tostring(suites, encoding="unicode")


def main() -> int:
    ap = argparse.ArgumentParser(prog="edacrux-pack-verify", add_help=True)
    ap.add_argument("--pack", help="verify one pack by id")
    ap.add_argument("--output", choices=["text", "junit"], default="text")
    ap.add_argument("--quiet", action="store_true", help="only show failures")
    a = ap.parse_args()

    if not PACKS.is_dir():
        print(f"error: no packs/ directory at {PACKS}", file=sys.stderr)
        return 2

    targets = sorted(p for p in PACKS.iterdir() if p.is_dir())
    if a.pack:
        targets = [p for p in targets if p.name == a.pack]
        if not targets:
            print(f"error: no pack named {a.pack!r}", file=sys.stderr)
            return 2

    results = [verify_pack(p) for p in targets]

    if a.output == "junit":
        print(to_junit(results))
    else:
        for r in results:
            total, failed = len(r.checks), len(r.failures)
            if r.ok:
                if not a.quiet:
                    print(f"  PASS  {r.pack:28s} {total} checks")
            else:
                print(f"  FAIL  {r.pack:28s} {total - failed}/{total} passed")
                for name, ok, detail in r.failures:
                    print(f"          ✗ {name}")
                    if detail:
                        print(f"              {detail}")
        n_ok = sum(1 for r in results if r.ok)
        n_checks = sum(len(r.checks) for r in results)
        print(f"\n  {n_ok}/{len(results)} packs passed, {n_checks} checks total")

    return 0 if all(r.ok for r in results) else 1


if __name__ == "__main__":
    sys.exit(main())
